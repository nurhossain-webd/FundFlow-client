# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# MongoDB database used only by the server-side Better Auth handler.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fundflow
MONGODB_DB_NAME=fundflow

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
IMGBB_API_KEY=

# Server-only credentials for existing Better Auth demo accounts.
# Never prefix demo passwords with NEXT_PUBLIC_.
DEMO_SUPPORTER_EMAIL=demo.supporter@fundflow.local
DEMO_SUPPORTER_PASSWORD=DemoSupporter123!
DEMO_ADMIN_EMAIL=demo.admin@fundflow.local
DEMO_ADMIN_PASSWORD=DemoAdmin123!

# Browser-safe application and Express API URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_STRIPE_TEST_MODE=true
NEXT_PUBLIC_CLIENT_REPOSITORY_URL=https://github.com/nurhossain-webd/FundFlow-client
NEXT_PUBLIC_GITHUB_URL=https://github.com/nurhossain-webd
NEXT_PUBLIC_LINKEDIN_URL=
NEXT_PUBLIC_X_URL=
