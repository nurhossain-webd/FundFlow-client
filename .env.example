# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# MongoDB database used only by the server-side Better Auth handler.
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/fundflow
MONGODB_DB_NAME=fundflow

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
IMGBB_API_KEY=

# Browser-safe application and Express API URLs.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_STRIPE_TEST_MODE=true
NEXT_PUBLIC_CLIENT_REPOSITORY_URL=https://github.com/nurhossain-webd/FundFlow-client
NEXT_PUBLIC_GITHUB_URL=https://github.com/nurhossain-webd
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/in/hossain-riyad
NEXT_PUBLIC_PORTFOLIO_URL=https://nurhossainportfolio.vercel.app
